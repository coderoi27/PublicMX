<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
        <meta name="theme-color" content="#F27F0D">
        <title>{% block title %}Mi Monchis - Alpha{% endblock %}</title>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
        <link rel="icon" href="{{ asset('images/mi-monchis-cuadrado.png') }}" type="image/png">
        <link rel="apple-touch-icon" href="{{ asset('images/mi-monchis-cuadrado.png') }}">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphpHotReload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}

        {% if app.environment != 'dev' or app.request.server.get('GOOGLE_ANALYTICS_ID') %}
            {% set ga_id = app.request.server.get('GOOGLE_ANALYTICS_ID') %}
            {% if ga_id %}
                <!-- Google tag (gtag.js) -->
                <script async src="https://www.googletagmanager.com/gtag/js?id={{ ga_id }}"></script>
                <script>
                  window.dataLayer = window.dataLayer || [];
                  function gtag(){dataLayer.push(arguments);}
                  gtag('js', new Date());

                  gtag('config', '{{ ga_id }}');
                </script>
            {% endif %}
        {% endif %}
    </head>
    <body>
        {% block body %}{% endblock %}
        <aside class="cookie-consent is-hidden" data-controller="cookie-consent" aria-label="Consentimiento de cookies">
            <div class="cookie-consent__panel">
                <div>
                    <strong>Tu privacidad en Mi Monchis</strong>
                    <p>Usamos tecnologías esenciales para operar la webapp y opcionales para analítica. Puedes aceptar todas o rechazar las no esenciales.</p>
                    <a href="{{ path('public_legal_show', { slug: 'cookies' }) }}">Ver política de cookies</a>
                </div>
                <div class="cookie-consent__actions">
                    <button type="button" data-action="cookie-consent#rejectOptional">Rechazar no esenciales</button>
                    <button type="button" data-action="cookie-consent#acceptAll">Aceptar todas</button>
                </div>
            </div>
        </aside>
    </body>
</html>

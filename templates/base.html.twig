<!DOCTYPE html>
<html lang="es" class="{% block html_class %}{% endblock %}">
    <head>
        {% if branding is defined %}
            {% set base_branding = branding %}
        {% else %}
            {% set base_branding = public_branding() %}
        {% endif %}
        {% set base_branding = base_branding|default({
            app_name: 'Mi Monchis MX',
            short_name: 'Mi Monchis',
            logo_url: '/images/branding/logo-simple-vertical.png',
            logo_horizontal_url: '/images/mi-monchis-horizontal.png',
            icon_url: '/images/mi-monchis-cuadrado.png',
            favicon_url: '/images/mi-monchis-cuadrado.png',
            theme_color: '#F27F0D',
            default_meta_title: 'Mi Monchis MX',
            default_meta_description: 'Explora locales, antojitos y lugares cercanos en Mi Monchis MX.',
            social_share: {
                title: 'Mi Monchis MX',
                description: 'Explora locales y antojos cercanos en Mi Monchis MX.',
                image_url: '/images/mi-monchis-cuadrado.png',
                twitter_card: 'summary_large_image'
            },
            copyright: '© 2026 Mi Monchis. Hecho con antojo.'
        }) %}
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
        <meta name="theme-color" content="{{ base_branding.theme_color|default('#F27F0D') }}">
        {% block meta %}
            <meta name="description" content="{{ base_branding.default_meta_description|e('html_attr') }}">
            <meta property="og:type" content="website">
            <meta property="og:title" content="{{ base_branding.social_share.title|default(base_branding.default_meta_title)|e('html_attr') }}">
            <meta property="og:description" content="{{ base_branding.social_share.description|default(base_branding.default_meta_description)|e('html_attr') }}">
            <meta property="og:site_name" content="{{ base_branding.app_name|e('html_attr') }}">
            <meta property="og:url" content="{{ app.request.uri|e('html_attr') }}">
            <meta property="og:image" content="{{ absolute_url(base_branding.social_share.image_url|default(base_branding.icon_url))|e('html_attr') }}">
            <meta name="twitter:card" content="{{ base_branding.social_share.twitter_card|default('summary_large_image')|e('html_attr') }}">
            <meta name="twitter:title" content="{{ base_branding.social_share.twitter_title|default(base_branding.social_share.title|default(base_branding.default_meta_title))|e('html_attr') }}">
            <meta name="twitter:description" content="{{ base_branding.social_share.twitter_description|default(base_branding.social_share.description|default(base_branding.default_meta_description))|e('html_attr') }}">
            <meta name="twitter:image" content="{{ absolute_url(base_branding.social_share.twitter_image_url|default(base_branding.social_share.image_url|default(base_branding.icon_url)))|e('html_attr') }}">
        {% endblock %}
        <title>{% block title %}{{ base_branding.default_meta_title|default('Mi Monchis MX') }}{% endblock %}</title>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
        <link rel="icon" href="{{ base_branding.favicon_url|default(base_branding.icon_url) }}">
        <link rel="apple-touch-icon" href="{{ base_branding.icon_url }}">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphpHotReload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}

        {% set ga_id = app.request.server.get('GOOGLE_ANALYTICS_MEASUREMENT_ID') ?? app.request.server.get('GOOGLE_ANALYTICS_ID') %}
        {% if app.environment == 'prod' and ga_id %}
            <script>
                // Consent Mode bloquea analitica hasta que el usuario acepte cookies opcionales.
                window.dataLayer = window.dataLayer || [];
                function gtag(){dataLayer.push(arguments);}
                window.__miMonchisAnalyticsId = '{{ ga_id|e('js') }}';
                window.__miMonchisAnalyticsPageViewSent = false;
                window.__miMonchisAnalyticsConsentGranted = false;
                window.__miMonchisHasAnalyticsConsent = function() {
                    try {
                        var consentStr = window.localStorage.getItem('mi_monchis_cookie_consent');
                        if (!consentStr) {
                            return false;
                        }

                        var consentObj = JSON.parse(consentStr);
                        return Boolean(consentObj && (consentObj.scope === 'all' || consentObj.categories?.analytics === true));
                    } catch(e) {
                        return false;
                    }
                };
                gtag('consent', 'default', {
                    'analytics_storage': 'denied',
                    'ad_storage': 'denied'
                });

                if (window.__miMonchisHasAnalyticsConsent()) {
                    window.__miMonchisAnalyticsConsentGranted = true;
                    gtag('consent', 'update', {
                        'analytics_storage': 'granted',
                        'ad_storage': 'granted'
                    });
                }
            </script>
            <script async src="https://www.googletagmanager.com/gtag/js?id={{ ga_id|e('html_attr') }}"></script>
            <script>
                window.dataLayer = window.dataLayer || [];
                function gtag(){dataLayer.push(arguments);}
                gtag('js', new Date());

                if (window.__miMonchisAnalyticsConsentGranted) {
                    gtag('config', window.__miMonchisAnalyticsId);
                    window.__miMonchisAnalyticsPageViewSent = true;
                } else {
                    gtag('config', window.__miMonchisAnalyticsId, { 'send_page_view': false });
                }

                window.__miMonchisGrantConsent = function() {
                    if (!window.__miMonchisAnalyticsId) {
                        return;
                    }

                    gtag('consent', 'update', {
                        'analytics_storage': 'granted',
                        'ad_storage': 'granted'
                    });

                    if (!window.__miMonchisAnalyticsPageViewSent) {
                        gtag('event', 'page_view', {
                            page_title: document.title,
                            page_location: window.location.href,
                            page_path: window.location.pathname + window.location.search
                        });
                        window.__miMonchisAnalyticsPageViewSent = true;
                    }
                };
                window.addEventListener('mi-monchis:analytics-consent-granted', window.__miMonchisGrantConsent);
            </script>
        {% endif %}

        {% set adsense_enabled = app.request.server.get('GOOGLE_ADSENSE_ENABLED') %}
        {% set adsense_id = app.request.server.get('GOOGLE_ADSENSE_CLIENT_ID') %}
        {% if app.environment == 'prod' and adsense_enabled and adsense_id %}
            <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client={{ adsense_id|e('html_attr') }}" crossorigin="anonymous"></script>
        {% endif %}
    </head>
    <body class="{% block body_class %}{% endblock %}">
        {% block body %}{% endblock %}
        <aside class="cookie-consent is-hidden" data-controller="cookie-consent" aria-label="Consentimiento de cookies">
            <div class="cookie-consent__panel" data-cookie-consent-target="panel">
                <div class="cookie-consent__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none">
                        <path d="M19.5 12.4a7.5 7.5 0 1 1-7.9-7.9 3.2 3.2 0 0 0 3.9 3.9 3.3 3.3 0 0 0 4 4Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M8.5 10.5h.01M11.2 15.2h.01M14.5 12.8h.01" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
                    </svg>
                </div>
                <div class="cookie-consent__copy">
                    <strong>Tu privacidad en Mi Monchis</strong>
                    <p>Usamos tecnologías esenciales para operar la webapp y opcionales para analítica. Puedes aceptar todas o rechazarlas no esenciales.</p>
                    <a href="{{ path('public_legal_show', { slug: 'cookies' }) }}">Ver política de cookies</a>
                </div>
                <div class="cookie-consent__actions">
                    <button type="button" data-action="cookie-consent#rejectOptional">Rechazar no esenciales</button>
                    <button type="button" data-action="cookie-consent#acceptAll">Aceptar todas</button>
                </div>
            </div>
        </aside>
    </body>
</html>

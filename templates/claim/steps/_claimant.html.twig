<div class="step-container" data-claim-flow-target="step" data-step-name="claimant" hidden>
    <h2>Datos del Reclamante</h2>
    <form data-action="submit->claim-flow#saveProgress">
        <label>Nombre: <input type="text" name="claimant_name" required></label>
        <label>Rol: <input type="text" name="claimant_role" required></label>
        <label>Email: <input type="email" name="email" required></label>
        <button type="submit">Guardar y Continuar</button>
    </form>
</div>

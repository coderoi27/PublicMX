{% extends 'base.html.twig' %}

{% block title %}Mi Monchis MX{% endblock %}

{% block body %}
    {% set is_authenticated = current_user is not null %}
    {% set hero_location_label = 'Guadalupe Tepeyac' %}
    {% if initial_location_label is defined and initial_location_label is not empty %}
        {% set hero_location_label = initial_location_label %}
    {% elseif query_lat is not empty and query_lng is not empty %}
        {% set hero_location_label = 'Ubicación actual' %}
    {% endif %}

    <main class="mobile-map-app">
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="mobile-map-app__flash">{{ message }}</div>
            {% endfor %}
        {% endfor %}

        <section
            class="mobile-map-app__shell"
            data-controller="map-shell"
            data-action="click@window->map-shell#closeNotificationsOnOutsideClick click@window->map-shell#closeLocationSwitcherOnOutsideClick keydown@window->map-shell#closeAuthModalOnEscape keydown@window->map-shell#closeMenuOnEscape"
            data-map-shell-feed-url-value="{{ path('public_api_map_feed') }}"
            data-map-shell-authenticated-value="{{ is_authenticated ? 'true' : 'false' }}"
            data-map-shell-me-url-value="{% if is_authenticated %}{{ path('public_api_me') }}{% endif %}"
            data-map-shell-favorites-url-value="{% if is_authenticated %}{{ path('public_api_favorites_collection') }}{% endif %}"
            data-map-shell-addresses-url-value="{% if is_authenticated %}{{ path('public_api_addresses_collection') }}{% endif %}"
            data-map-shell-google-maps-api-key-value="{{ google_maps_api_key }}"
            data-map-shell-claim-url-value="{{ path('public_claim_location') }}"
            data-map-shell-event-log-url-value="{{ path('public_api_interactions_log') }}"
            data-map-shell-walkthrough-enabled-value="{{ walkthrough_enabled ? 'true' : 'false' }}"
            data-map-shell-logo-url-value="{{ logo_url }}"
            data-map-shell-initial-favorites-value='{{ favorite_items|default([])|json_encode|raw }}'
            data-map-shell-initial-addresses-value='{{ saved_addresses|json_encode|raw }}'
            {% if initial_location_label is defined and initial_location_label is not empty %}data-map-shell-initial-location-label-value="{{ initial_location_label }}"{% endif %}
            {% if query_lat is not empty %}data-map-shell-lat-value="{{ query_lat }}"{% endif %}
            {% if query_lng is not empty %}data-map-shell-lng-value="{{ query_lng }}"{% endif %}
        >
            <div class="welcome-flow is-hidden" data-map-shell-target="walkthrough">
                <button type="button" class="welcome-flow__back" data-action="map-shell#goBackFromWalkthrough" aria-label="Volver">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M19 12H5" />
                        <path d="m12 5-7 7 7 7" />
                    </svg>
                </button>

                <section class="welcome-flow__card" aria-labelledby="walkthrough-title">
                    <img
                        src="{{ asset('images/mi-monchis-horizontal.png') }}"
                        alt="Mi Monchis MX"
                        class="welcome-flow__logo is-hidden"
                        data-map-shell-target="walkthroughLogo"
                    >
                    <div class="welcome-flow__headline">
                        <h1 class="welcome-flow__copy" id="walkthrough-title" data-map-shell-target="walkthroughCopy"></h1>
                        <div class="welcome-flow__cursor" data-map-shell-target="walkthroughCursor"></div>
                    </div>
                    <form class="welcome-flow__form is-hidden" data-map-shell-target="walkthroughForm" data-action="submit->map-shell#submitWalkthroughAddress">
                        <label class="welcome-flow__label" for="walkthrough-address">Escribe tu direccion postal</label>
                        <div class="welcome-flow__input-shell">
                            <svg viewBox="0 0 24 24" aria-hidden="true" class="welcome-flow__input-icon">
                                <path d="M12 21s-6-5.3-6-11a6 6 0 1 1 12 0c0 5.7-6 11-6 11Z" />
                                <path d="M12 12.8a2.8 2.8 0 1 0 0-5.6 2.8 2.8 0 0 0 0 5.6Z" />
                            </svg>
                            <input
                                id="walkthrough-address"
                                class="welcome-flow__input"
                                type="text"
                                placeholder="Ej. Av. Henry Ford 120, Guadalupe Tepeyac"
                                data-map-shell-target="walkthroughAddressInput"
                                data-action="input->map-shell#searchWalkthroughAddress blur->map-shell#queueHideWalkthroughSuggestions"
                                autocomplete="off"
                            >
                        </div>
                        <div class="welcome-flow__suggestions is-hidden" data-map-shell-target="walkthroughSuggestions"></div>
                                            <button
                        type="button"
                        class="welcome-flow__geo is-hidden"
                        data-map-shell-target="walkthroughGeoButton"
                        data-action="map-shell#detectLocationFromWalkthrough"
                    >
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M12 4v3" />
                            <path d="M12 17v3" />
                            <path d="M4 12h3" />
                            <path d="M17 12h3" />
                            <path d="M12 16a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z" />
                        </svg>
                        <span>o haz clic aqui para obtener tu ubicacion</span>
                    </button>
                        <button type="submit" class="welcome-flow__submit">
                            <span>Explorar</span>
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <circle cx="11" cy="11" r="6" />
                                <path d="m16 16 4 4" />
                            </svg>
                        </button>
                    </form>

                    <p class="welcome-flow__error is-hidden" data-map-shell-target="walkthroughError"></p>
                </section>

                <footer class="welcome-flow__footer">
                    {% include 'public/_partials/legal_links.html.twig' %}
                    <p>© 2026 Mi Monchis. Hecho con antojo.</p>
                </footer>
            </div>

            <header class="mobile-map-app__header">
                <div class="mobile-map-app__header-top">
                    <button type="button" class="mobile-map-app__icon-button mobile-map-app__icon-button--menu" aria-label="Menú" data-map-shell-target="menuButton" data-action="map-shell#toggleMenu">
                        <svg viewBox="0 0 24 24" aria-hidden="true" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none">
                            <path d="M4 6h16M4 12h16M4 18h16" />
                        </svg>
                    </button>
                    
                    <img src="{{ asset('images/mi-monchis-horizontal.png') }}" alt="Mi Monchis MX" class="mobile-map-app__brand-logo">

                    <form class="mobile-map-app__desktop-search is-desktop-only" data-action="submit->map-shell#submitDesktopSearch">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <circle cx="11" cy="11" r="6" />
                            <path d="m16 16 4 4" />
                        </svg>
                        <label for="desktop-location-search">Buscar locales</label>
                        <input
                            id="desktop-location-search"
                            type="search"
                            placeholder="Busca tacos, hamburguesas o el puesto de la esquina..."
                            data-map-shell-target="desktopSearchInput"
                            data-action="input->map-shell#filterByDesktopSearch"
                            autocomplete="off"
                        >
                        <button type="submit">Buscar</button>
                    </form>
                    
                    <div class="mobile-map-app__header-actions">
                        <div class="mobile-map-app__location-display is-desktop-only" data-map-shell-target="switcherToggle" data-switcher-mode="locations" data-action="click->map-shell#toggleLocationSwitcher" style="cursor: pointer;">
                            <svg class="mobile-map-app__pin-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M12 21s-6-5.3-6-11a6 6 0 1 1 12 0c0 5.7-6 11-6 11Zm0-8.2a2.8 2.8 0 1 0 0-5.6 2.8 2.8 0 0 0 0 5.6Z" />
                            </svg>
                            <span class="mobile-map-app__location-label" data-map-shell-target="heroLocationDesktop">{{ hero_location_label }}</span>
                            <svg class="mobile-map-app__service-caret" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="6 9 12 15 18 9"></polyline>
                            </svg>
                        </div>
                        
                        <div class="mobile-map-app__service-dropdown-container is-desktop-only">
                            <button
                                type="button"
                                class="mobile-map-app__service-pill"
                                data-map-shell-target="switcherToggle"
                                data-switcher-mode="services"
                                data-action="click->map-shell#toggleLocationSwitcher"
                            >
                                <span class="mobile-map-app__service-label" data-map-shell-target="serviceFilterLabel">Todo</span>
                                <svg class="mobile-map-app__service-caret" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="6 9 12 15 18 9"></polyline>
                                </svg>
                            </button>
                        </div>

                        <button type="button" class="mobile-map-app__icon-button mobile-map-app__icon-button--notify" aria-label="Notificaciones" data-map-shell-target="notificationsButton" data-action="map-shell#toggleNotifications">
                            <span class="mobile-map-app__notify-badge" data-map-shell-target="notificationsBadge">1</span>
                            <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                                <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                            </svg>
                        </button>
                        <div class="mobile-map-app__notifications is-hidden" data-map-shell-target="notificationsPanel">
                            <p class="mobile-map-app__notifications-title">Notificaciones</p>
                            <a href="{{ path('public_register') }}" class="mobile-map-app__notification-item">
                                <strong>Completa tu cuenta</strong>
                                <span>Registrate para disfrutar de las bondades de este directorio digital</span>
                            </a>
                        </div>
                    </div>
                </div>

                <div class="mobile-map-app__header-bottom is-mobile-only">
                    <div class="mobile-map-app__location-display" data-map-shell-target="switcherToggle" data-switcher-mode="locations" data-action="click->map-shell#toggleLocationSwitcher" style="cursor: pointer;">
                        <svg class="mobile-map-app__pin-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 21s-6-5.3-6-11a6 6 0 1 1 12 0c0 5.7-6 11-6 11Zm0-8.2a2.8 2.8 0 1 0 0-5.6 2.8 2.8 0 0 0 0 5.6Z" />
                        </svg>
                        <span class="mobile-map-app__location-label" data-map-shell-target="heroLocation">{{ hero_location_label }}</span>
                        <svg class="mobile-map-app__service-caret" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="6 9 12 15 18 9"></polyline>
                        </svg>
                    </div>
                    
                    <button
                        type="button"
                        class="mobile-map-app__service-pill"
                        data-map-shell-target="switcherToggle"
                        data-switcher-mode="services"
                        data-action="click->map-shell#toggleLocationSwitcher"
                    >
                        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M5 7h14"></path>
                            <path d="M7 12h10"></path>
                            <path d="M10 17h4"></path>
                        </svg>
                        <span data-map-shell-target="serviceFilterLabel">Todo</span>
                    </button>
                </div>

                <div class="mobile-map-app__location-switcher is-hidden" data-map-shell-target="locationSwitcher">
                    {# El contenido se renderiza dinámicamente desde el controlador Stimulus #}
                </div>
            </header>

            <aside class="mobile-map-app__menu is-hidden" data-map-shell-target="menuPanel" aria-label="Menú principal">
                <div class="mobile-map-app__menu-backdrop" data-action="click->map-shell#closeMenu"></div>
                <section class="mobile-map-app__menu-panel">
                    <header class="mobile-map-app__menu-head">
                        <img src="{{ asset('images/mi-monchis-horizontal.png') }}" alt="Mi Monchis MX">
                        <button type="button" class="mobile-map-app__menu-close" data-action="map-shell#closeMenu" aria-label="Cerrar menú">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M6 6 18 18" />
                                <path d="M18 6 6 18" />
                            </svg>
                        </button>
                    </header>
                    <form class="mobile-map-app__menu-search" data-action="submit->map-shell#submitDesktopSearch">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <circle cx="11" cy="11" r="6" />
                            <path d="m16 16 4 4" />
                        </svg>
                        <label for="mobile-location-search">Busca tu antojo</label>
                        <input
                            id="mobile-location-search"
                            type="search"
                            placeholder="Busca tacos, tortas, café..."
                            data-map-shell-target="mobileSearchInput"
                            data-action="input->map-shell#filterByDesktopSearch"
                            autocomplete="off"
                        >
                    </form>
                    <div class="mobile-map-app__menu-group mobile-map-app__menu-group--filters">
                        <p>Fuentes</p>
                        <div class="mobile-map-app__menu-source" data-map-shell-target="menuSourceFilterRow"></div>
                    </div>
                    <div class="mobile-map-app__menu-group mobile-map-app__menu-group--filters">
                        <p>Categorías</p>
                        <div class="mobile-map-app__menu-categories" data-map-shell-target="menuCategoryList"></div>
                    </div>
                    <div class="mobile-map-app__menu-group mobile-map-app__menu-group--filters">
                        <p>Ordenar por</p>
                        <div class="mobile-map-app__menu-source" data-map-shell-target="menuSortFilterRow"></div>
                    </div>
                    <div class="mobile-map-app__menu-group">
                        <p>Para locales</p>
                        <a href="{{ path('public_claim_location') }}">Reclamar o registrar mi local</a>
                    </div>
                    <div class="mobile-map-app__menu-actions">
                        {% if is_authenticated %}
                            <a href="{{ path('public_logout') }}">Cerrar sesión</a>
                        {% else %}
                            <a href="{{ path('public_login') }}">Iniciar sesión</a>
                            <a href="{{ path('public_register') }}">Crear cuenta</a>
                        {% endif %}
                    </div>
                </section>
            </aside>

            <section class="mobile-map-app__explore-shell" data-map-shell-target="exploreSection">
                <div class="mobile-map-app__map-stage" data-map-shell-target="mapStage">
                    <div class="map-shell__canvas" data-map-shell-target="canvas"></div>

                    <div class="mobile-map-app__status-pill">
                        <span data-map-shell-target="status">Cargando feed canonico...</span>
                        <strong data-map-shell-target="count">{{ locations|length }}</strong>
                    </div>

                    <aside class="mobile-map-app__route-panel is-hidden" data-map-shell-target="routePanel" aria-live="polite">
                        <div>
                            <span data-map-shell-target="routeStatus">Ruta dentro de Mi Monchis</span>
                            <strong data-map-shell-target="routeMeta">Selecciona un local para trazarla.</strong>
                        </div>
                        <button type="button" data-action="map-shell#clearInternalRoute">Limpiar</button>
                    </aside>

                    <div class="map-shell__canvas-note" data-map-shell-target="canvasNote">
                        <span class="map-shell__canvas-loader" aria-hidden="true"></span>
                        <span>Cargando mapa y locales...</span>
                    </div>

                    <div class="mobile-map-app__chip-row mobile-map-app__chip-row--map" data-map-shell-target="chipRowContainer">
                        <div class="mobile-map-app__source-segmented-control" data-map-shell-target="sourceFilterRow"></div>
                        <div style="display: contents;" data-map-shell-target="chipRow"></div>
                        <div class="mobile-map-app__sort-filter-row" data-map-shell-target="sortFilterRow"></div>
                    </div>

                    <div class="mobile-map-app__floating-controls">
                        <div class="mobile-map-app__zoom-stack">
                            <button type="button" class="mobile-map-app__control-button" data-action="map-shell#zoomIn" aria-label="Acercar">+</button>
                            <button type="button" class="mobile-map-app__control-button" data-action="map-shell#zoomOut" aria-label="Alejar">-</button>
                        </div>
                        <button type="button" class="mobile-map-app__control-button is-accent" data-action="map-shell#detectLocation" aria-label="Detectar mi ubicacion">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M12 4v3" />
                                <path d="M12 17v3" />
                                <path d="M4 12h3" />
                                <path d="M17 12h3" />
                                <path d="M12 16a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z" />
                                <path d="M12 19a7 7 0 1 0 0-14 7 7 0 0 0 0 14Z" />
                            </svg>
                        </button>
                    </div>

                    <div class="mobile-map-app__cards-rail" data-map-shell-target="list">
                        {% if locations is empty %}
                            <article class="mobile-map-app__empty-state">
                                <strong>Sin locales por ahora</strong>
                                <p>En cuanto el core devuelva puntos visibles, apareceran aqui.</p>
                            </article>
                        {% else %}
                            {% for location in locations %}
                                <article
                                    class="mobile-map-card {{ loop.first ? 'is-active' : '' }}"
                                    data-action="click->map-shell#focusLocation"
                                    data-location-id="{{ location.location_id }}"
                                    data-card-location-id="{{ location.location_id }}"
                                >
                                    <div class="mobile-map-card__media mobile-map-card__media--{{ (location.location_id % 4) + 1 }}">
                                        <button
                                            type="button"
                                            class="mobile-map-card__heart {{ location.location_id in favorite_location_ids ? 'is-active' : '' }}"
                                            data-action="map-shell#toggleFavorite"
                                            data-location-id="{{ location.location_id }}"
                                            aria-label="Guardar favorito"
                                        >
                                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                                <path d="M12 21s-7-4.4-9.2-8.5C.9 9.1 2.3 5 6.3 5c2.2 0 3.6 1.3 4.4 2.4C11.5 6.3 12.9 5 15.1 5c4 0 5.4 4.1 3.5 7.5C16.4 16.6 12 21 12 21Z" />
                                            </svg>
                                        </button>
                                        <div class="mobile-map-card__distance">
                                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                                <path d="M12 3.5 19 7v10l-7 3.5L5 17V7l7-3.5Z" />
                                                <path d="M12 8.2a3.8 3.8 0 1 0 0 7.6 3.8 3.8 0 0 0 0-7.6Z" />
                                            </svg>
                                            {{ location.distance_meters is not null ? (location.distance_meters >= 1000 ? ((location.distance_meters / 1000)|number_format(1, '.', '')) ~ ' km' : location.distance_meters ~ ' m') : 'Cerca' }}
                                        </div>
                                        <div class="mobile-map-card__media-copy">
                                            <span>{{ location.merchant_name|slice(0, 1)|upper }}</span>
                                        </div>
                                    </div>
                                    <div class="mobile-map-card__body">
                                        <h3>{{ location.location_name }}</h3>
                                        <p>{{ location.short_address ?: 'Direccion pendiente' }}{% if location.merchant_name %} • {{ location.merchant_name }}{% endif %}</p>
                                        <div class="mobile-map-card__meta">
                                            <span class="mobile-map-card__status">{{ location.publication_state == 'public_visible' ? 'Visible' : 'Pendiente' }}</span>
                                            <span class="mobile-map-card__reviews">
                                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                                    <path d="m12 3.8 2.6 5.3 5.8.8-4.2 4.1 1 5.8L12 17.1 6.8 19.8l1-5.8-4.2-4.1 5.8-.8L12 3.8Z" />
                                                </svg>
                                                Sin reviews
                                            </span>
                                        </div>
                                    </div>
                                </article>
                            {% endfor %}
                        {% endif %}
                    </div>
                </div>

                <section class="mobile-map-app__explore-list is-hidden" data-map-shell-target="exploreList">
                    <div class="mobile-map-app__explore-list-header">
                        <strong>Locales en esta zona</strong>
                        <span><span data-map-shell-target="countDuplicate">{{ locations|length }}</span> resultados</span>
                    </div>
                    <div class="mobile-map-app__explore-list-grid" data-map-shell-target="exploreListGrid">
                        {% if locations is empty %}
                            <article class="mobile-map-app__empty-state mobile-map-app__empty-state--list">
                                <strong>Sin locales por ahora</strong>
                                <p>En cuanto el core devuelva puntos visibles, apareceran aqui.</p>
                            </article>
                        {% endif %}
                    </div>
                </section>
            </section>

            <section class="mobile-map-app__panel is-hidden" data-map-shell-target="favoritesSection">
                <div class="mobile-map-app__panel-head">
                    <div>
                        <span class="mobile-map-app__eyebrow">Tu colección</span>
                        <h2>Favoritos</h2>
                    </div>
                    <span class="mobile-map-app__panel-count" data-map-shell-target="favoritesCount">0</span>
                </div>
                {% if not is_authenticated %}
                    <article class="mobile-map-app__auth-card">
                        <strong>Inicia sesión para guardar favoritos</strong>
                        <p>Tus favoritos se guardan en tu cuenta para recuperarlos desde cualquier sesión.</p>
                        <div class="mobile-map-app__auth-actions">
                            <a href="{{ path('public_login') }}">Iniciar sesión</a>
                            <a href="{{ path('public_register') }}">Crear cuenta</a>
                        </div>
                    </article>
                {% endif %}
                <div class="mobile-map-app__saved-list" data-map-shell-target="favoritesList"></div>
                <article class="mobile-map-app__policy-note">
                    <strong>Política de favoritos</strong>
                    <p>Por ahora solo puedes guardar locales Mi Monchis. Los Places se podrán guardar cuando estén reclamados o convertidos en ficha canónica.</p>
                </article>
            </section>

            <section class="mobile-map-app__panel is-hidden" data-map-shell-target="addressesSection">
                <div class="mobile-map-app__panel-head">
                    <div>
                        <span class="mobile-map-app__eyebrow">Ubicaciones guardadas</span>
                        <h2>Mis ubis</h2>
                    </div>
                    <span class="mobile-map-app__panel-count" data-map-shell-target="addressesCount">0</span>
                </div>
                {% if not is_authenticated %}
                    <article class="mobile-map-app__auth-card">
                        <strong>Crea una cuenta para guardar tus ubicaciones</strong>
                        <p>Las ubis quedan ligadas al usuario que las guardó y se pueden reutilizar desde el explorador.</p>
                        <div class="mobile-map-app__auth-actions">
                            <a href="{{ path('public_login') }}">Iniciar sesión</a>
                            <a href="{{ path('public_register') }}">Crear cuenta</a>
                        </div>
                    </article>
                {% else %}
                    <form class="mobile-map-app__address-form" data-action="submit->map-shell#saveAddress">
                        <div class="mobile-map-app__field-grid">
                            <label>
                                <span>Etiqueta</span>
                                <input type="text" placeholder="Casa, oficina, punto fijo..." data-map-shell-target="addressLabelInput">
                            </label>
                            <label>
                                <span>Ciudad</span>
                                <input type="text" placeholder="Ciudad" data-map-shell-target="addressCityInput">
                            </label>
                            <label>
                                <span>Estado</span>
                                <input type="text" placeholder="Estado" data-map-shell-target="addressStateInput">
                            </label>
                            <label class="mobile-map-app__field-span">
                                <span>Referencia</span>
                                <input type="text" placeholder="Colonia, avenida, notas..." data-map-shell-target="addressReferenceInput">
                            </label>
                        </div>
                        <div class="mobile-map-app__field-grid">
                            <label>
                                <span>Latitud</span>
                                <input type="text" placeholder="19.432608" data-map-shell-target="addressLatInput">
                            </label>
                            <label>
                                <span>Longitud</span>
                                <input type="text" placeholder="-99.133209" data-map-shell-target="addressLngInput">
                            </label>
                        </div>
                        <label class="mobile-map-app__checkbox-row">
                            <input type="checkbox" data-map-shell-target="addressPrimaryInput">
                            <span>Guardar como ubicación principal</span>
                        </label>
                        <div class="mobile-map-app__address-actions">
                            <button type="button" class="mobile-map-app__ghost-button" data-action="map-shell#prefillCurrentCoordinates">Usar mi ubicación actual</button>
                            <button type="submit" class="mobile-map-app__primary-button">Guardar ubi</button>
                        </div>
                        <p class="mobile-map-app__address-status" data-map-shell-target="addressStatus"></p>
                    </form>
                {% endif %}
                <div class="mobile-map-app__saved-list" data-map-shell-target="addressesList"></div>
            </section>

            <section class="mobile-map-app__panel is-hidden" data-map-shell-target="profileSection">
                <div class="mobile-map-app__panel-head">
                    <div>
                        <span class="mobile-map-app__eyebrow">Tu cuenta</span>
                        <h2>Perfil</h2>
                    </div>
                </div>
                {% if is_authenticated %}
                    <article class="mobile-map-app__auth-card">
                        <strong>{{ current_user.firstName }} {{ current_user.lastName }}</strong>
                        <p>{{ current_user.email }}</p>
                        <div class="mobile-map-app__meta-grid">
                            <span>Cuenta: <strong data-map-shell-target="profileStatus">Cargando...</strong></span>
                            <span>Favoritos: <strong data-map-shell-target="favoritesCountDuplicate">0</strong></span>
                            <span>Mis ubis: <strong data-map-shell-target="addressesCountDuplicate">0</strong></span>
                        </div>
                    </article>
                    <article class="mobile-map-app__auth-card">
                        <strong>Acciones rápidas</strong>
                        <p>Tu actividad se guarda para recuperar favoritos y Mis ubis en futuras sesiones.</p>
                        <div class="mobile-map-app__auth-actions">
                            <button type="button" data-action="map-shell#showFavoritesSection">Ver favoritos</button>
                            <button type="button" data-action="map-shell#showAddressesSection">Ver Mis ubis</button>
                        </div>
                    </article>
                    <article class="mobile-map-app__auth-card">
                        <strong>Legal aceptado</strong>
                        <div class="mobile-map-app__legal-status-list" data-map-shell-target="profileLegalList">
                            <p>Cargando aceptaciones...</p>
                        </div>
                    </article>
                {% else %}
                    <article class="mobile-map-app__auth-card">
                        <strong>Tu perfil se activa al registrarte</strong>
                        <p>Regístrate o inicia sesión para guardar favoritos, ubis y operar tu experiencia personal.</p>
                        <div class="mobile-map-app__auth-actions">
                            <a href="{{ path('public_login') }}">Iniciar sesión</a>
                            <a href="{{ path('public_register') }}">Crear cuenta</a>
                        </div>
                    </article>
                {% endif %}
                <article class="mobile-map-app__auth-card">
                    <strong>Privacidad y condiciones</strong>
                    <p>Consulta cómo usamos datos de ubicación, favoritos, cookies, Google Maps y servicios de terceros.</p>
                    {% include 'public/_partials/legal_links.html.twig' %}
                </article>
                <article class="mobile-map-app__auth-card">
                    <strong>Cookies y analítica</strong>
                    <p data-map-shell-target="cookieConsentStatus">Sin decisión registrada en este dispositivo.</p>
                    <div class="mobile-map-app__auth-actions">
                        <button type="button" data-action="map-shell#acceptCookiesFromProfile">Aceptar analítica</button>
                        <button type="button" data-action="map-shell#rejectCookiesFromProfile">Solo esenciales</button>
                        <button type="button" data-action="map-shell#resetCookiesFromProfile">Revisar banner</button>
                    </div>
                </article>
            </section>

            <aside class="mobile-map-app__detail-sheet is-hidden" data-map-shell-target="detailSheet">
                <div class="mobile-map-app__detail-backdrop" data-action="click->map-shell#closeDetailSheet"></div>
                <div class="mobile-map-app__detail-card">
                    <div class="mobile-map-app__detail-body" data-map-shell-target="detailSheetBody"></div>
                </div>
            </aside>

            <aside class="mobile-map-app__auth-modal is-hidden" data-map-shell-target="authModal" aria-modal="true" role="dialog" aria-labelledby="auth-modal-title">
                <div class="mobile-map-app__auth-modal-backdrop" data-action="click->map-shell#closeAuthModal"></div>
                <section class="mobile-map-app__auth-modal-card">
                    <div class="mobile-map-app__auth-modal-grabber" aria-hidden="true"></div>
                    <button type="button" class="mobile-map-app__auth-modal-close" data-action="map-shell#closeAuthModal" aria-label="Cerrar">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M6 6 18 18" />
                            <path d="M18 6 6 18" />
                        </svg>
                    </button>

                    <header class="mobile-map-app__auth-modal-head">
                        <h2 id="auth-modal-title" data-map-shell-target="authModalTitle">Mi Monchis</h2>
                        <p data-map-shell-target="authModalCopy">Descubre el sabor de tu barrio.</p>
                    </header>

                    <div class="mobile-map-app__auth-socials">
                        <a href="{{ path('connect_google_start') }}" class="mobile-map-app__auth-social mobile-map-app__auth-social--google">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                                <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                                <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/>
                                <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                            </svg>
                            <span>Continuar con Google</span>
                        </a>
                        <div class="mobile-map-app__auth-social-grid">
                            <button type="button" class="mobile-map-app__auth-social" disabled>
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path fill="#1877F2" d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07c0 6.02 4.39 11.01 10.13 11.93v-8.44H7.08v-3.49h3.04V9.41c0-3.03 1.79-4.7 4.53-4.7 1.31 0 2.69.24 2.69.24v2.97h-1.51c-1.49 0-1.96.93-1.96 1.89v2.26h3.33l-.53 3.49h-2.8V24C19.61 23.08 24 18.09 24 12.07Z"/>
                                </svg>
                                <span>Facebook</span>
                            </button>
                            <button type="button" class="mobile-map-app__auth-social mobile-map-app__auth-social--apple" disabled>
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path fill="currentColor" d="M16.5 12.2c0-2.4 2-3.5 2.1-3.6-1.1-1.7-2.9-1.9-3.5-1.9-1.5-.2-2.9.9-3.6.9-.8 0-1.9-.9-3.1-.8-1.6 0-3.1 1-3.9 2.4-1.7 3-.4 7.5 1.2 9.9.8 1.2 1.8 2.5 3.1 2.4 1.2 0 1.7-.8 3.2-.8s1.9.8 3.2.8 2.2-1.2 3-2.4c1-1.4 1.4-2.7 1.4-2.8 0 0-2.6-1-2.6-4.1ZM14.1 5.1c.7-.8 1.1-2 1-3.1-1 .1-2.2.7-2.9 1.5-.6.7-1.2 1.9-1 3 1.1.1 2.2-.6 2.9-1.4Z"/>
                                </svg>
                                <span>Apple ID</span>
                            </button>
                        </div>
                    </div>

                    <div class="mobile-map-app__auth-divider">
                        <span></span>
                        <strong>O CON EMAIL</strong>
                        <span></span>
                    </div>

                    <form method="post" action="{{ path('public_login') }}" class="mobile-map-app__auth-form">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                        <input type="hidden" name="_target_path" value="{{ path('public_home') }}">
                        <label>
                            <span>Email o Teléfono</span>
                            <div class="mobile-map-app__auth-input">
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M4 6h16v12H4z" />
                                    <path d="m4 7 8 6 8-6" />
                                </svg>
                                <input type="email" name="_username" placeholder="nombre@ejemplo.com" autocomplete="email" required>
                            </div>
                        </label>
                        <label>
                            <span>Contraseña</span>
                            <div class="mobile-map-app__auth-input">
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <rect x="5" y="10" width="14" height="10" rx="2" />
                                    <path d="M8 10V7a4 4 0 0 1 8 0v3" />
                                </svg>
                                <input type="password" name="_password" placeholder="••••••••" autocomplete="current-password" data-map-shell-target="authPasswordInput" required>
                                <button type="button" data-action="map-shell#toggleAuthPasswordVisibility" aria-label="Mostrar contraseña">
                                    <svg viewBox="0 0 24 24" aria-hidden="true">
                                        <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z" />
                                        <circle cx="12" cy="12" r="3" />
                                    </svg>
                                </button>
                            </div>
                        </label>
                        <button type="submit" class="mobile-map-app__auth-submit">Iniciar Sesión</button>
                    </form>

                    <footer class="mobile-map-app__auth-modal-foot">
                        <a href="{{ path('public_login') }}">¿Olvidaste tu contraseña?</a>
                        <p>¿No tienes una cuenta? <a href="{{ path('public_register') }}">Regístrate</a></p>
                    </footer>
                </section>
            </aside>

            <nav class="mobile-map-app__nav">
                <button type="button" class="mobile-map-app__nav-item is-active" data-map-shell-target="exploreTabButton" data-action="map-shell#showExploreSection">
                    <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                        <polyline points="9 22 9 12 15 12 15 22"></polyline>
                    </svg>
                    <span>Explorar</span>
                </button>
                <button type="button" class="mobile-map-app__nav-item" data-map-shell-target="favoritesTabButton" data-action="map-shell#showFavoritesSection">
                    <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                    </svg>
                    <span>Favoritos</span>
                </button>
                <button type="button" class="mobile-map-app__nav-item mobile-map-app__nav-item--center" data-action="map-shell#toggleMapListMode" data-map-shell-target="modeToggleButton">
                    <span class="mobile-map-app__nav-core">
                        <!-- Icono por defecto (mostrando listado para cambiar a listado cuando está en mapa) -->
                        <svg class="icon-list" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="8" y1="6" x2="21" y2="6"></line>
                            <line x1="8" y1="12" x2="21" y2="12"></line>
                            <line x1="8" y1="18" x2="21" y2="18"></line>
                            <line x1="3" y1="6" x2="3.01" y2="6"></line>
                            <line x1="3" y1="12" x2="3.01" y2="12"></line>
                            <line x1="3" y1="18" x2="3.01" y2="18"></line>
                        </svg>
                        <svg class="icon-map is-hidden" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"></polygon>
                            <line x1="8" y1="2" x2="8" y2="18"></line>
                            <line x1="16" y1="6" x2="16" y2="22"></line>
                        </svg>
                    </span>
                </button>
                <button type="button" class="mobile-map-app__nav-item" data-map-shell-target="addressesTabButton" data-action="map-shell#showAddressesSection">
                    <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                        <circle cx="12" cy="10" r="3"></circle>
                    </svg>
                    <span>Mis ubis</span>
                </button>
                <button type="button" class="mobile-map-app__nav-item" data-map-shell-target="profileTabButton" data-action="map-shell#showProfileSection">
                    <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                        <circle cx="12" cy="7" r="4"></circle>
                    </svg>
                    <span>Perfil</span>
                </button>
            </nav>

            <footer class="mobile-map-app__footer">
                <p>© 2026 Mi Monchis. Hecho con antojo.</p>
                {% include 'public/_partials/legal_links.html.twig' %}
            </footer>
        </section>
    </main>
{% endblock %}

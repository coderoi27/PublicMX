{% extends 'base.html.twig' %}

{% block title %}{{ location.location_name ?? 'Local' }} · Mi Monchis MX{% endblock %}
{% block meta %}
    {% set seo_name = location.location_name ?? location.merchant_name ?? 'Local Mi Monchis' %}
    {% set seo_description = location.short_description ?? location.service_notes ?? 'Consulta servicios, horario y ubicación de este local en Mi Monchis MX.' %}
    {% set seo_photo = location.photo_url ?? location.category_cover_photo_url ?? location.category_default_photo_url ?? asset('images/mi-monchis-cuadrado.png') %}
    <meta name="description" content="{{ seo_description|striptags|slice(0, 155)|e('html_attr') }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <meta property="og:type" content="place">
    <meta property="og:title" content="{{ seo_name|e('html_attr') }} · Mi Monchis MX">
    <meta property="og:description" content="{{ seo_description|striptags|slice(0, 155)|e('html_attr') }}">
    <meta property="og:url" content="{{ canonical_url }}">
    <meta property="og:image" content="{{ seo_photo }}">
{% endblock %}
{% block body_class %}location-profile-page{% endblock %}
{% block stylesheets %}
    {{ parent() }}
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
{% endblock %}

{% block body %}
    {% set name = location.location_name ?? location.merchant_name ?? 'Local Mi Monchis' %}
    {% set merchant = location.merchant_name ?? name %}
    {% set category = location.category_name ?? location.category_slug ?? 'Antojos cerca de ti' %}
    {% set address = location.short_address ?? 'Dirección pendiente' %}
    {% set photo = location.photo_url ?? location.category_cover_photo_url ?? location.category_default_photo_url ?? null %}
    {% set rating = location.rating ?? null %}
    {% set reviews = location.user_rating_count ?? location.user_ratings_total ?? null %}
    {% set is_open = location.open_now is defined and location.open_now is same as(true) %}
    {% set is_closed = location.open_now is defined and location.open_now is same as(false) %}
    {% set hours = location.opening_hours_text is defined and location.opening_hours_text is iterable ? location.opening_hours_text : [] %}
    {% set description = location.description ?? location.short_description ?? location.editorial_summary ?? null %}
    {% set services = [
        {'label': 'Servicio a domicilio', 'icon': 'delivery_dining', 'active': location.service_delivery ?? false},
        {'label': 'Para llevar', 'icon': 'takeout_dining', 'active': location.service_takeaway ?? false},
        {'label': 'Comer en el lugar', 'icon': 'restaurant', 'active': location.service_dine_in ?? false}
    ] %}
    {% set lat = location.lat ?? location.latitude ?? null %}
    {% set lng = location.lng ?? location.longitude ?? null %}
    {% set directions_url = lat and lng ? 'https://www.google.com/maps/dir/?api=1&destination=' ~ lat ~ ',' ~ lng : null %}
    {% set whatsapp_url = location.whatsapp_enabled and location.whatsapp_e164 ? 'https://wa.me/' ~ (location.whatsapp_e164|replace({'+': '', ' ': ''})) : null %}

    <main class="location-profile">
        <nav class="location-profile__nav" aria-label="Navegación del perfil">
            <a href="{{ path('public_home') }}" class="location-profile__nav-button" aria-label="Volver al mapa">
                <span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>
            </a>
            <div class="location-profile__nav-actions">
                <button type="button" class="location-profile__nav-button" aria-label="Compartir">
                    <span class="material-symbols-outlined" aria-hidden="true">share</span>
                </button>
                <button type="button" class="location-profile__nav-button" aria-label="Guardar favorito">
                    <span class="material-symbols-outlined" aria-hidden="true">favorite</span>
                </button>
            </div>
        </nav>

        <section class="location-profile__hero {{ photo ? 'has-photo' : '' }}" {% if photo %}style="background-image:url('{{ photo|e('html_attr') }}')"{% endif %}>
            <div class="location-profile__hero-overlay"></div>
            <div class="location-profile__hero-copy">
                <span class="location-profile__source">Mi Monchis</span>
                <h1>{{ name }}</h1>
                <p>{{ merchant != name ? merchant ~ ' · ' : '' }}{{ category }}</p>
            </div>
        </section>

        <section class="location-profile__shell">
            <aside class="location-profile__summary">
                <div class="location-profile__identity">
                    {% if location.gem_status is defined and location.gem_status == 'approved' %}
                        <span class="location-profile__badge">Joyita editorial</span>
                    {% endif %}
                    <h2>{{ name }}</h2>
                    <p>{{ description ?: 'Explora este local cercano, revisa sus servicios y decide tu siguiente antojo desde Mi Monchis.' }}</p>
                </div>

                <div class="location-profile__stats">
                    <div>
                        <strong>{{ rating ? rating|number_format(1) : 'N/D' }}</strong>
                        <span>{{ reviews ? reviews ~ ' reseñas' : 'Sin reseñas' }}</span>
                    </div>
                    <div>
                        <strong class="{{ is_open ? 'is-open' : (is_closed ? 'is-closed' : '') }}">{{ is_open ? 'Abierto' : (is_closed ? 'Cerrado' : 'Por confirmar') }}</strong>
                        <span>Estado actual</span>
                    </div>
                </div>

                <div class="location-profile__actions">
                    {% if whatsapp_url %}
                        <a href="{{ whatsapp_url }}" target="_blank" rel="noreferrer" class="location-profile__primary-action">
                            <span class="material-symbols-outlined" aria-hidden="true">chat</span>
                            Chatear con el local
                        </a>
                    {% else %}
                        <button type="button" class="location-profile__primary-action" disabled>
                            <span class="material-symbols-outlined" aria-hidden="true">chat</span>
                            WhatsApp pendiente
                        </button>
                    {% endif %}
                    {% if directions_url %}
                        <a href="{{ directions_url }}" target="_blank" rel="noreferrer" class="location-profile__secondary-action">
                            <span class="material-symbols-outlined" aria-hidden="true">directions</span>
                            Cómo llegar
                        </a>
                    {% endif %}
                    <a href="{{ qr_url }}" target="_blank" rel="noreferrer" class="location-profile__secondary-action">
                        <span class="material-symbols-outlined" aria-hidden="true">qr_code_2</span>
                        QR del local
                    </a>
                </div>
            </aside>

            <section class="location-profile__content">
                <article class="location-profile__card">
                    <div class="location-profile__section-head">
                        <h2>Servicios</h2>
                        <p>Disponibilidad visible para esta demo.</p>
                    </div>
                    <div class="location-profile__service-grid">
                        {% for service in services %}
                            <div class="location-profile__service {{ service.active ? 'is-active' : '' }}">
                                <span class="material-symbols-outlined" aria-hidden="true">{{ service.icon }}</span>
                                <strong>{{ service.label }}</strong>
                                <small>{{ service.active ? 'Disponible' : 'Por confirmar' }}</small>
                            </div>
                        {% endfor %}
                    </div>
                    {% if location.service_delivery_notes ?? null %}
                        <p class="location-profile__note">{{ location.service_delivery_notes }}</p>
                    {% endif %}
                </article>

                <article class="location-profile__card">
                    <div class="location-profile__section-head">
                        <h2>Ubicación</h2>
                        <p>{{ address }}</p>
                    </div>
                    <div class="location-profile__map-preview">
                        <span class="material-symbols-outlined" aria-hidden="true">location_on</span>
                    </div>
                </article>

                <article class="location-profile__card">
                    <div class="location-profile__section-head">
                        <h2>Horario</h2>
                        <p>{{ hours is not empty ? 'Horario publicado por el local.' : 'Horario pendiente de publicar.' }}</p>
                    </div>
                    {% if hours is not empty %}
                        <ul class="location-profile__hours">
                            {% for row in hours|slice(0, 7) %}
                                <li>{{ row }}</li>
                            {% endfor %}
                        </ul>
                    {% else %}
                        <p class="location-profile__empty">Aún no hay horario semanal disponible.</p>
                    {% endif %}
                </article>

                <article class="location-profile__card">
                    <div class="location-profile__section-head">
                        <h2>Productos destacados</h2>
                        <p>Espacio reservado para menú lite del local.</p>
                    </div>
                    <div class="location-profile__placeholder-grid">
                        <div><span></span><strong>Producto estrella</strong><small>Precio pendiente</small></div>
                        <div><span></span><strong>Combo recomendado</strong><small>Precio pendiente</small></div>
                    </div>
                </article>
            </section>
        </section>
    </main>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Iniciar sesion{% endblock %}

{% block body %}
    <main style="min-height: 100vh; display: grid; place-items: center; background: linear-gradient(180deg, #f9fafb 0%, #eef2f7 100%); padding: 1.5rem;">
        <section style="width: 100%; max-width: 420px; background: #ffffff; border: 1px solid #e5e7eb; border-radius: 20px; padding: 2rem;">
            <a href="{{ path('public_home') }}" style="display:inline-flex; align-items:center; margin-bottom:1rem; color:#475569; text-decoration:none; font-weight:700;">
                ← Volver al inicio
            </a>
            <h1 style="margin: 0 0 1rem;">Iniciar sesion</h1>
            {% if error %}
                <div style="margin-bottom: 1rem; border-radius: 12px; background: #fef2f2; color: #991b1b; padding: 0.9rem 1rem;">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}
            <form method="post">
                <input type="email" name="_username" value="{{ last_username }}" required placeholder="Email" style="width: 100%; margin-bottom: 1rem; border: 1px solid #d1d5db; border-radius: 12px; padding: 0.85rem 1rem;">
                <input type="password" name="_password" required placeholder="Password" style="width: 100%; margin-bottom: 1rem; border: 1px solid #d1d5db; border-radius: 12px; padding: 0.85rem 1rem;">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                <button type="submit" style="width: 100%; border: none; border-radius: 12px; background: #111827; color: #ffffff; padding: 0.9rem 1rem; font-weight: 700;">Entrar</button>
            </form>
            
            <div style="margin: 1.5rem 0; text-align: center; color: #6b7280; font-size: 0.875rem; display: flex; align-items: center;">
                <hr style="flex-grow: 1; border: none; border-top: 1px solid #e5e7eb;">
                <span style="padding: 0 0.75rem;">O</span>
                <hr style="flex-grow: 1; border: none; border-top: 1px solid #e5e7eb;">
            </div>

            <a href="{{ path('connect_google_start') }}" style="display: flex; align-items: center; justify-content: center; gap: 0.5rem; width: 100%; background: #ffffff; border: 1px solid #d1d5db; border-radius: 12px; padding: 0.85rem 1rem; color: #374151; font-weight: 600; text-decoration: none;">
                <svg width="20" height="20" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                    <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                    <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                    <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                </svg>
                Continuar con Google
            </a>
        </section>
    </main>
{% endblock %}
